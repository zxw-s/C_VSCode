{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "gcc-build-c",
            "type": "cppbuild", //shell
            "command": "E:/mingw64/bin/gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-finput-charset=UTF-8",
                "-fexec-charset=GBK",
                "-g",
                "-Wall",
                "-std=c17",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "E:/mingw64/bin"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "gcc编译当前C源文件"
        }
    ]
}